        <mxCell id="mjqiqH-cvQNA3rXOEZoA-101" value="&lt;strong data-end=&quot;861&quot; data-start=&quot;836&quot;&gt;Инфраструктурная (Q3)&amp;nbsp;&lt;/strong&gt;&lt;div&gt;Разворачивание DataHub, Nessie, MinIO&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="mjqiqH-cvQNA3rXOEZoA-100">
