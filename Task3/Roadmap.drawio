        <mxCell id="mjqiqH-cvQNA3rXOEZoA-96" value="&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;strong style=&quot;&quot; data-end=&quot;206&quot; data-start=&quot;176&quot;&gt;Инфраструктурная (Q1 – Q2)&amp;nbsp;&lt;/strong&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Разварачивание Kafka +&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt; Debezium CDC и&amp;nbsp;разворачивание ClickHouse&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;" vertex="1" parent="mjqiqH-cvQNA3rXOEZoA-95">
